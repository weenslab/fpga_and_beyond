<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="counter_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="counter_tb" />
            <top_module name="glbl" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="150.201 ns"></ZoomEndTime>
      <Cursor1Time time="0.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="216"></NameColumnWidth>
      <ValueColumnWidth column_width="64"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="6" />
   <wvobject fp_name="/counter_tb/dut/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/dut/rst_n" type="logic">
      <obj_property name="ElementShortName">rst_n</obj_property>
      <obj_property name="ObjectShortName">rst_n</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/dut/clr" type="logic">
      <obj_property name="ElementShortName">clr</obj_property>
      <obj_property name="ObjectShortName">clr</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/dut/start" type="logic">
      <obj_property name="ElementShortName">start</obj_property>
      <obj_property name="ObjectShortName">start</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/dut/q" type="array">
      <obj_property name="ElementShortName">q[3:0]</obj_property>
      <obj_property name="ObjectShortName">q[3:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/counter_tb/dut/cnt_reg" type="array">
      <obj_property name="ElementShortName">cnt_reg[3:0]</obj_property>
      <obj_property name="ObjectShortName">cnt_reg[3:0]</obj_property>
   </wvobject>
</wave_config>
